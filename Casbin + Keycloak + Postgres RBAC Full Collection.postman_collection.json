    {
      "name": "3. Bob (Editor Role Tests)",
      "item": [
        {
          "name": "Bob - GET Articles (Expect 200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Check if Authorization header was sent",
                  "const authHeader = pm.request.headers.get(\"Authorization\");",
                  "",
                  "if (authHeader) {",
                  "    if (authHeader.startsWith(\"Bearer \")) {",
                  "        const token = authHeader.substring(7); // strip \"Bearer \"",
                  "        console.log(\"✅ Bearer token was sent\");",
                  "        console.log(\"Token preview:\", token.substring(0, 15) + \"...\");",
                  "        pm.test(\"Bearer token is present in request\", function () {",
                  "            pm.expect(authHeader).to.match(/^Bearer .+/);",
                  "        });",
                  "    } else {",
                  "        console.log(\"⚠️ Authorization header exists but is not a Bearer token:\", authHeader);",
                  "    }",
                  "} else {",
                  "    console.log(\"❌ No Authorization header was sent\");",
                  "    pm.test(\"Bearer token is present in request\", function () {",
                  "        pm.expect.fail(\"No Authorization header found in request\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bob_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/api/articles",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "api",
                "articles"
              ]
            }
          },
          "response": []
        },
