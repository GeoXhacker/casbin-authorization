      "name": "1. Keycloak Authentication",
      "item": [
        {
          "name": "Login as Bob (Editor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();\nif (res.access_token) {\n    // Explicitly target the active environment\n    pm.environment.set(\"bob_token\", res.access_token); \n    console.log(\"Token saved successfully:\", res.access_token.substring(0, 15) + \"...\");\n} else {\n    console.log(\"Error: No access_token found in response\", res);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "username",
                  "value": "bob"
                },
                {
                  "key": "password",
                  "value": "password123"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloak_url}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          },
          "response": []
        },
